15.Rotate array left by one position.
import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 40, 50};

        int first = arr[0];

        for (int i = 0; i < arr.length - 1; i++) {
            arr[i] = arr[i + 1];
        }

        arr[arr.length - 1] = first;

        System.out.println("Left rotated array = " + Arrays.toString(arr));
    }
}
output:
Left rotated array = [20, 30, 40, 50, 10]

16.Rotate array right by one position
import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 40, 50};

        int last = arr[arr.length - 1];

        for (int i = arr.length - 1; i > 0; i--) {
            arr[i] = arr[i - 1];
        }

        arr[0] = last;

        System.out.println("Right rotated array = " + Arrays.toString(arr));
    }
}
output:
Right rotated array = [50, 10, 20, 30, 40]

17.Find the frequency of each element.
import java.util.HashMap;

public class Main {
    public static void main(String[] args) {
        int[] arr = {10, 20, 10, 30, 20, 10, 40};

        HashMap<Integer, Integer> frequency = new HashMap<>();

        for (int num : arr) {
            frequency.put(num, frequency.getOrDefault(num, 0) + 1);
        }

        System.out.println("Frequency of each element:");

        for (int key : frequency.keySet()) {
            System.out.println(key + " = " + frequency.get(key));
        }
    }
}
output:
Frequency of each element:
10 = 3
20 = 2
30 = 1
40 = 1

18.Sort an array in ascending order (without using Arrays.sort()).
import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        int[] arr = {50, 20, 40, 10, 30};

        for (int i = 0; i < arr.length - 1; i++) {
            for (int j = i + 1; j < arr.length; j++) {
                int max = Math.max(arr[i], arr[j]);
                int min = Math.min(arr[i], arr[j]);

                arr[i] = min;
                arr[j] = max;
            }
        }

        System.out.println("Ascending order = " + Arrays.toString(arr));
    }
}
output:
Ascending order = [10, 20, 30, 40, 50]

