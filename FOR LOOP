6.Count even and odd numbers.
public class Main {
    public static void main(String[] args) {
        int[] arr = {10, 15, 20, 25, 30, 35, 40};

        int even = 0;
        int odd = 0;

        for (int num : arr) {
            even += 1 - (num % 2);
            odd += num % 2;
        }

        System.out.println("Even count = " + even);
        System.out.println("Odd count = " + odd);
    }
}
output:
Even count = 4
Odd count = 3

