10.Find the second largest element.
public class Main {
    public static void main(String[] args) {
        int[] arr = {10, 25, 7, 89, 45};

        int largest = Integer.MIN_VALUE;
        int secondLargest = Integer.MIN_VALUE;

        for (int num : arr) {
            int newLargest = Math.max(largest, num);
            secondLargest = Math.max(secondLargest, Math.min(largest, num));
            largest = newLargest;
        }

        System.out.println("Second largest element = " + secondLargest);
    }
}
output:
Second largest element = 45

