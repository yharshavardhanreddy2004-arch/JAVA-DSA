6.//compare To Igonare case
public class CompareToIgnoreCaseExample {
    public static void main(String[] args) {

        String str1 = "Java";
        String str2 = "JAVA";
        String str3 = "Apple";
        String str4 = "banana";
        String str5 = "Zoo";
        String str6 = "apple";

        // Equal strings (ignoring case)
        System.out.println(str1.compareToIgnoreCase(str2));

        // Negative result
        System.out.println(str3.compareToIgnoreCase(str4));

        // Positive result
        System.out.println(str5.compareToIgnoreCase(str6));
    }
}
output:
0
-1
25

