9.//copy Value Of
public class CopyValueOfExample {
    public static void main(String[] args) {

        char[] chars = {'H', 'a', 'r', 's', 'h','a'};

        // Convert complete char array to String
        String str1 = String.copyValueOf(chars);

        // Convert part of char array to String
        String str2 = String.copyValueOf(chars, 1, 4);

        System.out.println("Complete String: " + str1);
        System.out.println("Partial String: " + str2);
    }
}
output:
Complete String: Harsha
Partial String: arsh

