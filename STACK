8.Duplicate Elements.
import java.util.Stack;

public class Main {
    public static void main(String[] args) {

        Stack<Integer> stack = new Stack<>();

        stack.push(63);
        stack.push(27);
        stack.push(91);
        stack.push(14);
        stack.push(63);
        stack.push(48);
        stack.push(27);
        stack.push(82);
        stack.push(35);
        stack.push(91);

        Stack<Integer> result = new Stack<>();

        for (int i = 0; i < stack.size(); i++) {
            if (!result.contains(stack.get(i))) {
                result.push(stack.get(i));
            }
        }

        System.out.println("Original Stack: " + stack);
        System.out.println("After Removing Duplicates: " + result);
    }
}

output:
Original Stack: [63, 27, 91, 14, 63, 48, 27, 82, 35, 91]
After Removing Duplicates: [63, 27, 91, 14, 48, 82, 35]

9.second largest integer.
import java.util.Stack;

public class Main {
    public static void main(String[] args) {

        Stack<Integer> stack = new Stack<>();

        stack.push(63);
        stack.push(27);
        stack.push(91);
        stack.push(14);
        stack.push(48);
        stack.push(82);
        stack.push(35);
        stack.push(76);

        int largest = Integer.MIN_VALUE;
        int secondLargest = Integer.MIN_VALUE;

        for (int i = 0; i < stack.size(); i++) {

            int value = stack.get(i);

            if (value > largest) {
                secondLargest = largest;
                largest = value;
            }
            else if (value > secondLargest && value != largest) {
                secondLargest = value;
            }
        }

        System.out.println("Stack: " + stack);
        System.out.println("Largest = " + largest);
        System.out.println("Second Largest = " + secondLargest);
    }
}

output:
Stack: [63, 27, 91, 14, 48, 82, 35, 76]
Largest = 91
Second Largest = 82

