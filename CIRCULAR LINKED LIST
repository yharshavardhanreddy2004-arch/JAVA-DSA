4. Searching.
  class CircularSearching {

    class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
        }
    }

    Node head = null;

    void insert(int data) {
        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            newNode.next = head;
        } else {
            Node temp = head;

            while (temp.next != head) {
                temp = temp.next;
            }

            temp.next = newNode;
            newNode.next = head;
        }
    }

    void search(int key) {

        if (head == null) {
            System.out.println("List is empty");
            return;
        }

        Node temp = head;
        int position = 1;

        do {
            if (temp.data == key) {
                System.out.println(
                    key + " found at position " + position
                );
                return;
            }

            temp = temp.next;
            position++;

        } while (temp != head);

        System.out.println(key + " not found");
    }

    public static void main(String[] args) {

        CircularSearching list = new CircularSearching();

        list.insert(32);
        list.insert(45);
        list.insert(78);
        list.insert(93);
        list.insert(56);

        list.search(93);
    }
}
output:
93 found at position 4
  
