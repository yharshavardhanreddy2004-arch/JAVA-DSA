class Traversal {

    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    public static void main(String[] args) {

        Node head = new Node(1);
        head.next = new Node(2);
        head.next.next = new Node(3);
        head.next.next.next = new Node(4);
        head.next.next.next.next = new Node(5);

        Node temp = head;

        System.out.println("Linked List:");

        while (temp != null) {
            System.out.print(temp.data + " -> ");
            temp = temp.next;
        }

        System.out.println("NULL");
    }
}

output:
Linked List:
1 -> 2 -> 3 -> 4 -> 5 -> NULL

3. Deletion.
class Deletion {

    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    public static void main(String[] args) {

        Node head = new Node(100);
        head.next = new Node(200);
        head.next.next = new Node(300);
        head.next.next.next = new Node(400);

        int value = 200;

        if (head != null && head.data == value) {
            head = head.next;
        } else {

            Node temp = head;

            while (temp != null && temp.next != null) {

                if (temp.next.data == value) {
                    temp.next = temp.next.next;
                    break;
                }

                temp = temp.next;
            }
        }

        System.out.println("After Deletion:");

        Node temp = head;

        while (temp != null) {
            System.out.print(temp.data + " -> ");
            temp = temp.next;
        }

        System.out.println("NULL");
    }
}
output:
After Deletion:
100 -> 300 -> 400 -> NULL

4. Searching.
class Searching {

    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    public static void main(String[] args) {

        Node head = new Node(100);
        head.next = new Node(200);
        head.next.next = new Node(300);
        head.next.next.next = new Node(400);

        int searchValue = 300;

        Node temp = head;
        boolean found = false;

        while (temp != null) {

            if (temp.data == searchValue) {
                found = true;
                break;
            }

            temp = temp.next;
        }

        if (found) {
            System.out.println(searchValue + " found in the linked list.");
        } else {
            System.out.println(searchValue + " not found in the linked list.");
        }
    }
}

output:
300 found in the linked list.

5. Updating.
class Updating {

    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }

    public static void main(String[] args) {

        Node head = new Node(21);
        head.next = new Node(42);
        head.next.next = new Node(67);
        head.next.next.next = new Node(23);

        int oldValue = 67;
        int newValue = 50;

        Node temp = head;

        while (temp != null) {

            if (temp.data == oldValue) {
                temp.data = newValue;
                break;
            }

            temp = temp.next;
        }

        System.out.println("After Updating:");

        temp = head;

        while (temp != null) {
            System.out.print(temp.data + " -> ");
            temp = temp.next;
        }

        System.out.println("NULL");
    }
}

output:
After Updating:
21 -> 42 -> 50 -> 23 -> NULL
