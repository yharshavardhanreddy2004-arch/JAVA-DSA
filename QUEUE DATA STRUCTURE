**Reverse a Stack
import java.util.Stack;

public class Main {
    public static void main(String[] args) {

        Stack<Integer> stack = new Stack<>();

        stack.push(25);
        stack.push(71);
        stack.push(14);
        stack.push(89);
        stack.push(36);

        System.out.println("Original Stack: " + stack);

        Stack<Integer> reverse = new Stack<>();

        while (!stack.isEmpty()) {
            reverse.push(stack.pop());
        }

        System.out.println("Reversed Stack: " + reverse);
    }
}
Output:
Original Stack: [25, 71, 14, 89, 36]
Reversed Stack: [36, 89, 14, 71, 25]

**Duplicate Elements in Queue.
import java.util.Queue;
import java.util.LinkedList;

public class Main {
    public static void main(String[] args) {

        Queue<Integer> queue = new LinkedList<>();

        queue.add(45);
        queue.add(72);
        queue.add(18);
        queue.add(45);
        queue.add(91);
        queue.add(72);
        queue.add(34);
        queue.add(18);

        System.out.println("Queue: " + queue);

        System.out.println("Duplicate Elements:");

        for (int i = 0; i < queue.size(); i++) {

            int count = 0;
            int value = ((LinkedList<Integer>) queue).get(i);

            for (int j = 0; j < queue.size(); j++) {
                if (((LinkedList<Integer>) queue).get(j) == value) {
                    count++;
                }
            }

            if (count > 1) {

                boolean alreadyPrinted = false;

                for (int k = 0; k < i; k++) {
                    if (((LinkedList<Integer>) queue).get(k) == value) {
                        alreadyPrinted = true;
                    }
                }

                if (!alreadyPrinted) {
                    System.out.println(value);
                }
            }
        }
    }
}

Output:
Queue: [45, 72, 18, 45, 91, 72, 34, 18]
Duplicate Elements:
45
72
18

**Count Repeated Numbers in Queue.
import java.util.Queue;
import java.util.LinkedList;

public class Main {
    public static void main(String[] args) {

        Queue<Integer> queue = new LinkedList<>();

        queue.add(45);
        queue.add(72);
        queue.add(18);
        queue.add(45);
        queue.add(91);
        queue.add(72);
        queue.add(34);
        queue.add(18);
        queue.add(45);

        System.out.println("Queue: " + queue);

        for (int i = 0; i < queue.size(); i++) {

            int value = ((LinkedList<Integer>) queue).get(i);
            int count = 0;

            for (int j = 0; j < queue.size(); j++) {

                if (((LinkedList<Integer>) queue).get(j) == value) {
                    count++;
                }
            }

            boolean alreadyPrinted = false;

            for (int k = 0; k < i; k++) {

                if (((LinkedList<Integer>) queue).get(k) == value) {
                    alreadyPrinted = true;
                    break;
                }
            }

            if (!alreadyPrinted && count > 1) {
                System.out.println(value + " repeated " + count + " times");
            }
        }
    }
}
Output:
Queue: [45, 72, 18, 45, 91, 72, 34, 18, 45]

45 repeated 3 times
72 repeated 2 times
18 repeated 2 times
