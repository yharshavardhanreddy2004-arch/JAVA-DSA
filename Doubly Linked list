        newNode.prev = temp;
    }

    void deleteAtPosition(int position) {
        if (head == null) {
            System.out.println("List is empty");
            return;
        }

        Node temp = head;

        // Delete first node
        if (position == 1) {
            head = head.next;

            if (head != null) {
                head.prev = null;
            }

            return;
        }

        // Move to the required position
        for (int i = 1; i < position && temp != null; i++) {
            temp = temp.next;
        }

        if (temp == null) {
